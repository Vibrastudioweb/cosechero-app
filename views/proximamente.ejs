<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Cosechero — Próximamente</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="prox-body">
  <main class="prox">
    <header class="prox-top">
      <img class="prox-logo" src="/img/cosechero-mark.png" alt="Cosechero">
      <div class="prox-brand">
        <span class="prox-nombre">cosechero</span>
        <span class="prox-sub">Mercado mayorista</span>
      </div>
    </header>

    <section class="prox-hero">
      <span class="prox-badge"><span class="prox-dot"></span> Próximamente · Venezuela</span>

      <h1 class="prox-titulo">
        Estamos construyendo el <span class="prox-acento">mercado mayorista</span> de hortalizas más grande del país.
      </h1>

      <p class="prox-mensaje">
        La primera plataforma que conecta a productores y compradores de todo el campo venezolano. Fresco, transparente y directo del origen.
      </p>

      <div class="prox-imagen">
        <img src="/img/hero-hortalizas.jpg" alt="Hortalizas frescas recién cosechadas">
      </div>

      <a href="/bienvenida" class="prox-btn">
        Continuar
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </section>

    <footer class="prox-footer">
      <span>Creado por</span>
      <img src="/img/vibra.png" alt="Vibra">
    </footer>
  </main>
</body>
</html>
