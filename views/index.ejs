<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cosechero — Qué llegó hoy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <a href="/" class="logo">
      <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="15" cy="15" r="15" fill="#FFBA08"/>
        <path d="M9 20C9 13 14 9 21 9C21 16 17 21 10 21C9.5 21 9 20.5 9 20Z" fill="#2D6A4F"/>
        <path d="M9 20L18 11" stroke="#FFF8EC" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <div>
        <h1>Cosechero</h1>
        <p class="tagline">Comercio mayorista</p>
      </div>
    </a>
  </header>

  <main>
    <p class="mercado">📍 <%= mercadoNombre %></p>

    <nav class="nav-tabs">
      <a href="/" class="activo">Qué llegó hoy</a>
      <a href="/publicar">Publicar</a>
    </nav>

    <% if (ok) { %>
      <div class="aviso-ok">¡Publicado! Ya aparece en la lista de hoy.</div>
    <% } %>

    <% if (publicaciones.length === 0) { %>
      <div class="vacio">
        <p>Todavía no hay publicaciones hoy.</p>
        <p>Si eres productor, <a href="/publicar">publica lo que llegó</a>.</p>
      </div>
    <% } else { %>
      <% publicaciones.forEach(function(p) { %>
        <div class="card">
          <% if (p.foto) { %>
            <img class="foto" src="<%= p.foto %>" alt="<%= p.producto %>">
          <% } else { %>
            <div class="foto-placeholder">🥬</div>
          <% } %>
          <div class="info">
            <p class="producto"><%= p.producto %></p>
            <p class="cantidad"><%= p.cantidad %> · <%= p.presentacion %></p>
            <p class="precio"><%= p.precio === 'consultar' ? 'Consultar precio' : ('Bs ' + p.precio) %></p>
            <a class="btn-whatsapp" href="<%= p.whatsappHref %>" target="_blank" rel="noopener">
              💬 Contactar
            </a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>

  <a href="/publicar" class="fab">+ Publicar</a>
</body>
</html>
