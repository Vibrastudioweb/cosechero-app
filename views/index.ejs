<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cosechero — Qué llegó hoy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <a href="/hoy" class="logo">
      <img src="/img/cosechero-mark.png" alt="Cosechero">
      <div>
        <h1>cosechero</h1>
        <p class="tagline">Mercado mayorista</p>
      </div>
    </a>
  </header>

  <main>
    <nav class="nav-tabs">
      <a href="/hoy" class="activo">Qué llegó hoy</a>
      <a href="/publicar">Publicar</a>
    </nav>

    <% if (ok) { %>
      <div class="aviso-ok">¡Publicado! Ya aparece en la lista de hoy.</div>
    <% } %>

    <% if (publicaciones.length === 0) { %>
      <div class="vacio">
        <p>Todavía no hay publicaciones hoy.</p>
        <p>Si eres productor, <a href="/publicar">publica lo que llegó</a>.</p>
      </div>
    <% } else { %>
      <% publicaciones.forEach(function(p) { %>
        <div class="card">
          <% if (p.foto) { %>
            <img class="foto" src="<%= p.foto %>" alt="<%= p.producto %>">
          <% } else { %>
            <div class="foto-placeholder"><%= p.icono %></div>
          <% } %>
          <div class="info">
            <p class="producto"><%= p.producto %></p>
            <p class="cantidad"><%= p.cantidad %> · <%= p.presentacion %></p>
            <% if (p.ubicacion) { %>
              <p class="ubicacion">📍 <%= p.ubicacion.ciudad %>, <%= p.ubicacion.estado %></p>
            <% } %>
            <p class="precio"><%= p.precio === 'consultar' ? 'Consultar precio' : ('Bs ' + p.precio) %></p>
            <a class="btn-whatsapp" href="<%= p.whatsappHref %>" target="_blank" rel="noopener">
              💬 Contactar
            </a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>

  <a href="/publicar" class="fab">+ Publicar</a>
</body>
</html>
