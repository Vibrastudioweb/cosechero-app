<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cosechero — Entrar</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bienvenida-body">
  <main class="bienvenida">
    <div class="bienvenida-blob"></div>

    <div class="bienvenida-logo" style="width:84px;height:84px;">
      <img src="/img/cosechero-mark.png" alt="Cosechero">
    </div>

    <p class="rol-badge"><%= rol === 'productor' ? 'Productor' : 'Comprador' %></p>
    <h1 class="entrar-titulo">¿Cuál es tu número de WhatsApp?</h1>
    <p class="mensaje">Así te reconocemos la próxima vez. Sin contraseña, sin código.</p>

    <% if (error) { %>
      <div class="error" style="margin-bottom: 16px; position: relative; z-index: 1;"><%= error %></div>
    <% } %>

    <form action="/entrar" method="POST" class="form-entrar">
      <input type="hidden" name="rol" value="<%= rol %>">
      <input type="tel" name="telefono" placeholder="0414-1234567" value="<%= telefono %>" required autofocus>
      <button type="submit" class="btn-entrar">Continuar</button>
    </form>

    <a href="/" class="link-publicar">← Volver</a>
  </main>
</body>
</html>
